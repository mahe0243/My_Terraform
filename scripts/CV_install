---
- name: Install Commvault Agent
  hosts: all
  become: yes

  vars:
    cv_package_src: /root/Unix.tar
    cv_package_dest: /root/Unix.tar
    cv_extract_dir: /root/commvault

    commserve_hostname: hostname of CV
    auth_code: your_auth_code
    install_dir: /opt

  tasks:

    - name: Create extraction directory
      file:
        path: "{{ cv_extract_dir }}"
        state: directory

    - name: Copy media
      copy:
        src: "{{ cv_package_src }}"
        dest: "{{ cv_package_dest }}"

    - name: Extract media
      unarchive:
        src: "{{ cv_package_dest }}"
        dest: "{{ cv_extract_dir }}"
        remote_src: true

    - name: Find cvpkgadd
      find:
        paths: "{{ cv_extract_dir }}"
        patterns: cvpkgadd
        recurse: yes
      register: cvpkgadd_file

    - name: Create silent XML
      template:
        src: cv_silent.xml.j2
        dest: /root/cv_silent.xml
        mode: "0644"

    - name: Validate XML
      command: xmllint --noout /root/cv_silent.xml
      register: xml_check
      changed_when: false

    - name: Run Installer
      command: >
        {{ cvpkgadd_file.files[0].path }}
        -silent
        -p /root/cv_silent.xml
      register: cv_install
      ignore_errors: true

    - name: Show installer result
      debug:
        var: cv_install

    - name: Fail if installer failed
      fail:
        msg: "Commvault installation failed"
      when: cv_install.rc != 0

    - name: Check Simpana status
      shell: commvault status
      register: commvault_status
      ignore_errors: true
      changed_when: false

    - name: Display Simpana status
      debug:
        var: commvault_status.stdout_lines
